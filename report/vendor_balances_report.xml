<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ========================================================= -->
    <!-- REPORT ACTION -->
    <!-- ========================================================= -->

    <record id="action_vendor_balances_report" model="ir.actions.report">

        <field name="name">Vendor Balances</field>

        <field name="model">vendor.balances</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">
            account_statement_reports.vendor_balances_report
        </field>

        <field name="report_file">
            account_statement_reports.vendor_balances_report
        </field>

        <field name="binding_model_id" ref="model_vendor_balances"/>

        <field name="binding_type">report</field>

    </record>

    <!-- ========================================================= -->
    <!-- REPORT TEMPLATE -->
    <!-- ========================================================= -->

    <template id="vendor_balances_report">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="doc">

                <t t-call="web.external_layout">

                    <div class="page">

                        <h2>Vendor Balances</h2>

                        <div class="row mb-3">

                            <div class="col-6">

                                <strong>Company:</strong>

                                <span t-esc="doc.company_id.name"/>

                            </div>

                            <div class="col-6 text-end">

                                <strong>As At:</strong>

                                <span t-esc="doc.date_to"/>

                            </div>

                        </div>

                        <table class="table table-sm table-bordered">

                            <thead>

                                <tr>

                                    <th>Vendor</th>

                                    <th class="text-end">
                                        Balance
                                    </th>

                                    <th>
                                        Type
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                <t t-foreach="docs" t-as="line">

                                    <tr>

                                        <td>
                                            <span t-esc="line.partner_id.name"/>
                                        </td>

                                        <td class="text-end">

                                            <span
                                                t-esc="abs(line.balance)"
                                                t-options='{
                                                    "widget": "monetary",
                                                    "display_currency": line.currency_id
                                                }'
                                            />

                                        </td>

                                        <td>

                                            <span t-esc="line.balance_type"/>

                                        </td>

                                    </tr>

                                </t>

                            </tbody>

                        </table>

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>