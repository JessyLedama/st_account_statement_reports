<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ========================================================= -->
    <!-- CUSTOMER BALANCES LIST VIEW -->
    <!-- ========================================================= -->

    <record id="view_customer_balances_list" model="ir.ui.view">
        <field name="name">customer.balances.list</field>
        <field name="model">customer.balances</field>
        <field name="arch" type="xml">
            <list string="Customer Balances">

                <field name="partner_id"/>
                <field name="date_to"/>
                <field name="balance"/>
                <field name="balance_type"/>
                <field name="currency_id"/>
            </list>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- CUSTOMER BALANCES WIZARD -->
    <!-- ========================================================= -->

    <record id="view_customer_balances_wizard_form" model="ir.ui.view">
        <field name="name">customer.balances.wizard.form</field>
        <field name="model">customer.balances.wizard</field>
        <field name="arch" type="xml">

        <form string="Customer Balances">
            <group>

                <field name="date_to"/>
                <field name="currency_id" />
            </group>

            <footer>

                <button
                    name="action_show_balances"
                    string="Show Balances"
                    type="object"
                    class="btn-primary"
                />

                <!-- <button
                    name="action_print_pdf"
                    string="Print PDF"
                    type="object"
                    class="btn-secondary"
                /> -->

                <button
                    string="Cancel"
                    special="cancel"
                    class="btn-secondary"
                />

            </footer>

            </form>

        </field>
    </record>

    <!-- ========================================================= -->
    <!-- WIZARD ACTION -->
    <!-- ========================================================= -->

    <record id="action_customer_balances_wizard" model="ir.actions.act_window">
        <field name="name">Customer Balances</field>
        <field name="res_model">customer.balances.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ========================================================= -->
    <!-- CUSTOMER BALANCES MENU -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_customer_balances"
        name="Customer Balances"
        parent="account.menu_finance_receivables"
        action="action_customer_balances_wizard"
        sequence="30"
    />

</odoo>